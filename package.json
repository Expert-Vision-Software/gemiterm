{
  "name": "gemiterm",
  "version": "2.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "dev": "bun run src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:parity": "bun test tests/parity",
    "test:smoke": "bun test tests/smoke",
    "test:all": "bun test",
    "lint:mediation": "bash scripts/lint-path-mediation.sh",
    "lint:mediation:ps": "pwsh scripts/lint-path-mediation.ps1",
    "build": "bun build --compile --target=bun --outdir=dist src/cli/index.ts",
    "build:linux": "bun build --compile --target=bun-linux-x64 --outdir=dist src/cli/index.ts",
    "build:windows": "bun build --compile --target=bun-windows-x64 --outdir=dist src/cli/index.ts"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0"
  }
}
